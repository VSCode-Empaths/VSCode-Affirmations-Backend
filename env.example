# Local: copy to .env (never commit .env)

# Supabase: Project Settings → Database → connection string (URI)
# Prefer "Session" pooler if direct connection fails (EHOSTUNREACH / IPv6).
# PGSSLMODE recommended for remote DBs.
DATABASE_URL=postgresql://...
PGSSLMODE=require

PORT=7890
API_URL=http://localhost

# Auth / cookies
JWT_SECRET=
SALT_ROUNDS=10
COOKIE_NAME=
# Admin user list for GET /api/v1/users: single email and/or comma-separated list (case-insensitive)
ADMIN_EMAIL=
ADMIN_EMAILS=
# Local HTTP: false → SameSite=lax (fine for same-origin or top-level redirects only).
# Production (HTTPS API + SPA on another origin, e.g. Netlify → Fly): MUST be true so
# Set-Cookie uses SameSite=None; Secure. Otherwise OAuth callback sets a cookie, but
# credentialed fetch from the SPA to the API will not send it → GET /api/v1/users/me 401.
SECURE_COOKIES=false

# GitHub OAuth (if used)
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_REDIRECT_URI=
# Post–GitHub OAuth redirect (Netlify or local dev origin)
REDIRECT_URL=https://error-affirmations-v2.netlify.app

# Optional: CORS in lib/app.js must include this origin + your Fly API URL
