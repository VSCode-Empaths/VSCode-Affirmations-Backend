# Local: copy to .env (never commit .env)

# Supabase: Project Settings → Database → connection string (URI)
# Prefer "Session" pooler if direct connection fails (EHOSTUNREACH / IPv6).
# PGSSLMODE recommended for remote DBs.
DATABASE_URL=postgresql://...
PGSSLMODE=require

PORT=7890
API_URL=http://localhost

# Auth / cookies
JWT_SECRET=
SALT_ROUNDS=10
COOKIE_NAME=
SECURE_COOKIES=false

# GitHub OAuth (if used)
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_REDIRECT_URI=
REDIRECT_URL=

# Optional: CORS and deploy URL (add your https://<app>.fly.dev in lib/app.js)
